effects = Array[Resource]([SubResource("Effect")])
weight = 1.0
cooldown_days = 7
max_per_season = 0
is_negative = false
telegraph_days = 0
duration_days = 1
mutex_group = &"merchant"
activity_affinities = PackedStringArray("item_purchased", "item_sold")
title_key = &"DIR_VISIT_TITLE"
explanation_key = &"DIR_VISIT_WHY"
counter_hint_key = &"DIR_VISIT_COUNTER"
