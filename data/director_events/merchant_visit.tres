[gd_resource type="Resource" script_class="DirectorEventData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/director_event_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/director_condition_data.gd" id="2"]
[ext_resource type="Script" path="res://scripts/data/director_effect_data.gd" id="3"]

[sub_resource type="Resource" id="Condition0"]
script = ExtResource("2")
kind = &"dry_start"

[sub_resource type="Resource" id="Condition1"]
script = ExtResource("2")
kind = &"extra_visit"

[sub_resource type="Resource" id="Effect"]
script = ExtResource("3")
kind = &"merchant_visit"
npc_id = &"minh"
location_id = &"minh_market"

[resource]
script = ExtResource("1")
id = &"merchant_visit"
tags = PackedStringArray("merchant")
