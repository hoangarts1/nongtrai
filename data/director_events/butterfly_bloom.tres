[gd_resource type="Resource" script_class="DirectorEventData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/data/director_event_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/director_condition_data.gd" id="2"]
[ext_resource type="Script" path="res://scripts/data/director_effect_data.gd" id="3"]

[sub_resource type="Resource" id="Condition0"]
script = ExtResource("2")
kind = &"metric_min"
metric_id = &"biodiversity"
threshold_id = &"butterflies"

[sub_resource type="Resource" id="Effect"]
script = ExtResource("3")
kind = &"butterfly_accent"
accent_color = Color(1, 0.82, 0.24, 1)

[resource]
script = ExtResource("1")
id = &"butterfly_bloom"
tags = PackedStringArray("butterfly")
conditions = Array[Resource]([SubResource("Condition0")])
effects = Array[Resource]([SubResource("Effect")])
weight = 1.0
cooldown_days = 7
max_per_season = 0
is_negative = false
telegraph_days = 0
duration_days = 2
mutex_group = &"butterfly"
activity_affinities = PackedStringArray("crop_planted", "plot_watered", "crop_harvested")
title_key = &"DIR_BLOOM_TITLE"
explanation_key = &"DIR_BLOOM_WHY"
counter_hint_key = &"DIR_BLOOM_COUNTER"
