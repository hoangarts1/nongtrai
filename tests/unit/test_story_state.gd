extends GutTest
const CONFIG: StoryConfig = preload("res://data/story/chapter1.tres")
func test_actual_known_progress_unlocks_pages_once_but_not_full_chapter_or_m2() -> void:
	var state: StoryState = StoryState.new()
	assert_true(state.configure(CONFIG))
	assert_eq(state.serialize(),StorySnapshotCodec.empty())
	assert_true(state.can_read_page(&"intro"))
	assert_false(state.can_read_page(&"page_sale"))
	assert_true(state.observe(CONFIG.supported_ids()).changed)
	assert_true(state.can_read_page(&"page_sale"))
	assert_false(state.observe(CONFIG.supported_ids()).changed)
	assert_true(state.acknowledge_page(&"page_sale",state.get_revision()).changed)
	assert_false(state.acknowledge_page(&"page_sale",state.get_revision()).changed)
	assert_false(state.is_complete())
	assert_false(state.observe(PackedStringArray(["m2_4_station"])).ok)
	assert_eq(state.serialize().completed_objectives.size(),7)
func test_bad_observations_and_stale_page_requests_leave_state_unchanged() -> void:
	var state: StoryState = StoryState.new()
	assert_false(state.deserialize(StorySnapshotCodec.empty()))
	assert_false(state.observe(PackedStringArray()).ok)
	state.configure(CONFIG)
	var quote: int = state.get_revision()
	assert_false(state.acknowledge_page(&"page_harvest",quote).ok)
	for ids: PackedStringArray in [PackedStringArray(["missing"]),PackedStringArray(["repair_house"]),PackedStringArray(["first_sale","first_sale"])]: assert_false(state.observe(ids).ok)
	assert_eq(state.serialize(),StorySnapshotCodec.empty())
	assert_true(state.observe(PackedStringArray(["first_sowing"])).ok)
	assert_false(state.acknowledge_page(&"intro",quote).ok)
	assert_false(state.acknowledge_page(&"intro",-2).ok)
	assert_eq(state.serialize().read_pages,[])
func test_data_and_return_values_detach_and_native_json_restore_is_silent() -> void:
	var config: StoryConfig = CONFIG.frozen_copy()
	var state: StoryState = StoryState.new()
	state.configure(config)
	config.pages[0].objective_id = &"repair_house"
	assert_true(state.can_read_page(&"intro"))
	state.observe(PackedStringArray(["first_sale"]))
	state.acknowledge_page(&"page_sale")
	var saved: Dictionary = state.serialize()
	var copy: Dictionary = state.serialize()
	copy.completed_objectives.clear()
	assert_eq(state.serialize(),saved)
	var calls: Array[int] = [0]
	state.changed.connect(func() -> void: calls[0] += 1)
	var revision: int = state.get_revision()
	assert_true(state.deserialize(JSON.parse_string(JSON.stringify(saved))))
	assert_eq(calls[0],0)
	assert_gt(state.get_revision(),revision)
	assert_eq(state.serialize(),saved)
	assert_false(state.deserialize({"completed_objectives":["repair_house"],"read_pages":[]}))
	assert_eq(state.serialize(),saved)
