extends GutTest
const CONFIG: DogConfig = preload("res://data/dog_config.tres")

func test_adjacent_commit_stale_owner_nav_and_forged_nonadjacent_quotes_rejected() -> void:
	var owner: DogState = DogState.new()
	var nav: DogNavigation = DogNavigation.new()
	var service: DogMovementService = DogMovementService.new()
	assert_true(owner.configure(CONFIG, Vector2i(-10, -10)))
	assert_true(nav.configure(CONFIG))
	assert_true(service.configure(CONFIG, owner, nav))
	var quote: Dictionary = service.quote_step(Vector2i(-9, -10))
	assert_true(quote.ok)
	assert_true(owner.try_set_name("Milo").ok)
	assert_false(service.step(quote).ok)
	quote = service.quote_step(Vector2i(-9, -10))
	var blocks: Array[Rect2i] = [Rect2i(-9, -10, 1, 1)]
	assert_true(nav.set_dynamic_obstacles(blocks))
	assert_false(service.step(quote).ok)
	assert_eq(owner.get_cell(), Vector2i(-10, -10))
	blocks.clear()
	assert_true(nav.set_dynamic_obstacles(blocks))
	quote = service.quote_step(Vector2i(-9, -10))
	var bad: Dictionary = quote.duplicate(true)
	bad.target = Vector2i(-5, -10)
	assert_false(service.step(bad).ok)
	assert_true(service.step(quote).ok)
	assert_false(service.step(quote).ok)
	assert_eq(owner.get_cell(), Vector2i(-9, -10))

func test_callback_reentry_and_invalid_origin_only_repair_preserve_name() -> void:
	var owner: DogState = DogState.new()
	var nav: DogNavigation = DogNavigation.new()
	var service: DogMovementService = DogMovementService.new()
	assert_true(owner.configure(CONFIG, Vector2i.ZERO))
	assert_true(owner.try_set_name("Milo").ok)
	assert_true(nav.configure(CONFIG))
	assert_true(service.configure(CONFIG, owner, nav))
	assert_false(nav.is_walkable(owner.get_cell()))
	var results: Array[bool] = []
	var callback: Callable = func(_cell: Vector2i, _name: String) -> void:
		results.append(service.is_busy())
		results.append(service.repair_invalid_origin().ok)
		results.append(service.configure(CONFIG, owner, nav))
	owner.changed.connect(callback)
	assert_true(service.repair_invalid_origin().ok)
	owner.changed.disconnect(callback)
	assert_eq(results, [true, false, false])
	assert_true(nav.is_walkable(owner.get_cell()))
	assert_eq(DogFollowRules.distance(owner.get_cell(), Vector2i.ZERO), 1)
	assert_eq(owner.get_name(), "Milo")
	var valid: Vector2i = owner.get_cell()
	assert_false(service.repair_invalid_origin().changed)
	assert_eq(owner.get_cell(), valid)

func test_fully_covered_map_waits_without_moving_or_losing_name() -> void:
	var owner: DogState = DogState.new()
	var nav: DogNavigation = DogNavigation.new()
	var service: DogMovementService = DogMovementService.new()
	assert_true(owner.configure(CONFIG, Vector2i(-10, -10)))
	assert_true(owner.try_set_name("Milo").ok)
	var all_blocked: Array[Rect2i] = [CONFIG.world.player_region]
	assert_true(nav.configure(CONFIG, all_blocked))
	assert_true(service.configure(CONFIG, owner, nav))
	var before: Dictionary = owner.serialize()
	assert_false(service.repair_invalid_origin().ok)
	assert_eq(owner.serialize(), before)
	all_blocked.clear()
	assert_true(nav.set_dynamic_obstacles(all_blocked))
	assert_true(service.repair_invalid_origin().ok)
	assert_eq(owner.serialize(), before)
