extends GutTest

func test_real_signed_cash_and_refunds_do_not_inflate_income() -> void:
	var ledger: DayLedgerState = DayLedgerState.new()
	ledger.reset(3)
	ledger.record(105,&"sell_produce")
	ledger.record(-80,&"buy_seed")
	ledger.record(20,&"refund")
	ledger.record(-35,&"minh_discount")
	ledger.record(35,&"minh_rollback")
	ledger.record(0,&"load")
	assert_eq(ledger.totals(),{"income":105,"expense":60,"profit":45})
	assert_eq(ledger.rows().size(),5)
	assert_eq(ledger.day_index,3)

func test_trade_metadata_groups_without_counting_cash_twice() -> void:
	var ledger: DayLedgerState = DayLedgerState.new()
	for quantity: int in [2,3]:
		ledger.record(quantity*35,&"sell_produce")
		ledger.annotate_trade(&"sell_produce",&"spring_carrot",quantity,quantity*35)
	assert_eq(ledger.rows().size(),1)
	assert_eq(ledger.rows()[0]["quantity"],5)
	assert_eq(ledger.rows()[0]["item_id"],"spring_carrot")
	assert_eq(ledger.totals()["income"],175)
	ledger.record(-80,&"buy_seed")
	ledger.record(20,&"refund")
	ledger.annotate_trade(&"buy_seed",&"turnip_seed",4,80)
	assert_eq(ledger.rows()[1]["quantity"],0,"Partial/refunded purchase does not assert a false quantity")

func test_round_trip_and_copy_do_not_share_mutable_saved_entries() -> void:
	var ledger: DayLedgerState = DayLedgerState.new()
	ledger.reset(5,false)
	ledger.record(45,&"minh_request")
	var saved: Dictionary = ledger.serialize()
	var restored: DayLedgerState = DayLedgerState.new()
	restored.deserialize(JSON.parse_string(JSON.stringify(saved)))
	assert_eq(restored.serialize(),saved)
	assert_false(restored.complete)
	saved["entries"][0]["amount"] = 900
	var rows: Array[Dictionary] = ledger.rows()
	rows[0]["amount"] = 800
	assert_eq(ledger.totals()["profit"],45)
	ledger.reset(6)
	assert_true(ledger.complete)
	assert_eq(ledger.totals()["profit"],0)

func test_malformed_history_and_overflow_are_partial_and_safe() -> void:
	var ledger: DayLedgerState = DayLedgerState.new()
	ledger.deserialize({"day_index":"bad","complete":true,"entries":[null,{"amount":INF},{"amount":"2"},{"amount":2,"reason":[]},{"amount":20,"reason":"sale","quantity":"bad"}]})
	assert_eq(ledger.day_index,0)
	assert_false(ledger.complete)
	assert_eq(ledger.totals()["income"],20)
	ledger.deserialize({"entries":"not a list"})
	assert_false(ledger.complete)
	assert_true(ledger.rows().is_empty())
	ledger.reset(0)
	ledger.record(DayLedgerState.MAX_JSON_INTEGER,&"other")
	ledger.record(1,&"other")
	assert_false(ledger.complete)
	assert_eq(ledger.totals()["income"],DayLedgerState.MAX_JSON_INTEGER)

func test_review_cancel_forced_guard_and_reconciliation_are_serializable() -> void:
	var state: DayEndState = DayEndState.new()
	assert_true(state.review(0,false))
	assert_false(state.review(0,false))
	assert_true(state.cancel())
	assert_true(state.review(0,true))
	assert_false(state.cancel())
	assert_true(state.confirm(0))
	assert_false(state.confirm(0))
	var restored: DayEndState = DayEndState.new()
	restored.deserialize(JSON.parse_string(JSON.stringify(state.serialize())))
	restored.reconcile(0)
	assert_eq(restored.phase,DayEndState.Phase.REVIEW,"Same old day requires review, not automatic replay")
	restored.reconcile(1)
	assert_eq(restored.phase,DayEndState.Phase.IDLE)
	assert_eq(restored.last_completed_day,0)
	assert_false(restored.review(0,false))
	assert_true(restored.review(1,false))
	state.deserialize({"phase":INF,"day_index":"x","forced":[],"last_completed_day":999})
	state.reconcile(0)
	assert_true(state.review(0,true),"Corrupt completion metadata cannot permanently block the current day")
