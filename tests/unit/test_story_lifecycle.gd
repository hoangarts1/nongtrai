extends GutTest
const CONFIG: StoryConfig = preload("res://data/story/chapter1.tres")
func test_prepare_restore_silent_single_owner_and_reset_invalidate_old_quotes() -> void:
	var state: StoryState = StoryState.new()
	state.configure(CONFIG)
	var flow: StoryLifecycle = StoryLifecycle.new()
	assert_true(flow.configure(CONFIG,state))
	var calls: Array[int] = [0]
	state.changed.connect(func() -> void: calls[0] += 1)
	var quote: int = state.get_revision()
	var prepared: Dictionary = flow.prepare({"quests":{"completed":[false,true]}})
	assert_true(prepared.ok)
	assert_eq(state.serialize(),StorySnapshotCodec.empty())
	assert_true(flow.restore(prepared))
	assert_eq(state.serialize(),{"completed_objectives":["first_sowing"],"read_pages":[]})
	assert_false(state.acknowledge_page(&"intro",quote).ok)
	assert_eq(calls[0],0)
	assert_true(flow.reset())
	assert_eq(state.serialize(),StorySnapshotCodec.empty())
	assert_eq(calls[0],0)
func test_bad_candidates_never_replace_and_busy_publication_blocks_all_lifecycle() -> void:
	var state: StoryState = StoryState.new()
	state.configure(CONFIG)
	var flow: StoryLifecycle = StoryLifecycle.new()
	flow.configure(CONFIG,state)
	var before: Dictionary = state.serialize()
	for candidate: Dictionary in [{},{"ok":1,"snapshot":before},{"ok":true,"snapshot":[]},{"ok":true,"snapshot":{"completed_objectives":["repair_house"],"read_pages":[]}}]: assert_false(flow.restore(candidate))
	assert_eq(state.serialize(),before)
	var attempts: Array[bool] = []
	var callback: Callable = func() -> void:
		attempts.append(flow.prepare({}).ok)
		attempts.append(flow.restore({"ok":true,"snapshot":before}))
		attempts.append(flow.reset())
		attempts.append(flow.configure(CONFIG,state))
	state.changed.connect(callback)
	state.observe(PackedStringArray(["first_sale"]))
	state.changed.disconnect(callback)
	assert_eq(attempts,[false,false,false,false])
	assert_eq(state.serialize().completed_objectives,["first_sale"])
	assert_false(flow.is_busy())
func test_unconfigured_and_wrong_owner_cannot_prepare_or_replace() -> void:
	var flow: StoryLifecycle = StoryLifecycle.new()
	assert_false(flow.configure(CONFIG,StoryState.new()))
	assert_false(flow.prepare({}).ok)
	assert_false(flow.restore({"ok":true,"snapshot":StorySnapshotCodec.empty()}))
	assert_false(flow.reset())
