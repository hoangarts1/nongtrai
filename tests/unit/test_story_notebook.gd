extends GutTest
const FIXTURE: Script = preload("res://tests/helpers/story_fixture.gd")
var f: RefCounted
var panel: NpcPanel
func before_each() -> void:
	f = FIXTURE.new()
	f.setup(self)
	panel = f.main.npc_system.journal
func after_each() -> void:
	f.cleanup()
	await get_tree().process_frame
func open_book() -> LifeStoryNotebook:
	f.main.npc_system.open_journal()
	await f.settle(self)
	await f.mouse(self,panel.book.story_button.get_global_rect().get_center())
	return panel.book.story_sheet

func test_native_entry_ecology_back_tabs_and_keyboard_preserve_quest_counts() -> void:
	var before: Dictionary = f.owners()
	await f.key(self,KEY_J)
	assert_true(panel.visible)
	assert_eq(QuestBookSnapshot.capture(f.main).entries.size(),DataRegistry.get_all_quests().size()+1)
	await f.mouse(self,panel.book.story_button.get_global_rect().get_center())
	assert_not_null(panel.book.story_sheet)
	assert_false(panel.book.body.visible)
	assert_eq(panel.book.story_sheet.objectives.rows.size(),10)
	assert_eq(panel.book.story_sheet.milestones.rows.size(),4)
	await f.mouse(self,panel.book.ecology_button.get_global_rect().get_center())
	assert_null(panel.book.story_sheet)
	assert_not_null(panel.book.ecology_sheet)
	await f.mouse(self,panel.book.story_button.get_global_rect().get_center())
	assert_null(panel.book.ecology_sheet)
	assert_not_null(panel.book.story_sheet)
	panel.book.story_sheet.back_button.grab_focus()
	await f.key(self,KEY_ENTER)
	assert_null(panel.book.story_sheet)
	assert_true(panel.book.body.visible)
	assert_true(panel.book.find_children("*","ProgressBar",true,false).is_empty())
	await f.mouse(self,panel.book.story_button.get_global_rect().get_center())
	await f.key(self,KEY_Q)
	assert_true(f.main.character_flow.panel.visible)
	assert_null(panel.book.story_sheet)
	await f.key(self,KEY_E)
	assert_true(panel.visible)
	assert_null(panel.book.story_sheet)
	await f.key(self,KEY_ESCAPE)
	assert_false(panel.visible)
	assert_eq(f.owners(),before)
func test_hidden_entry_new_load_title_and_repeat_open_free_lazy_branches() -> void:
	panel.book.story_button.pressed.emit()
	assert_null(panel.book.story_sheet)
	var children: int = panel.book.paper.get_child_count()
	for _i: int in range(3):
		assert_not_null(await open_book())
		await f.key(self,KEY_J)
		assert_null(panel.book.story_sheet)
		assert_eq(panel.book.paper.get_child_count(),children)
	assert_not_null(await open_book())
	assert_true(f.main.call("_load_payload",SaveService.load_game(1)))
	await f.settle(self)
	assert_null(panel.book.story_sheet)
	assert_not_null(await open_book())
	f.main.call("_start_new_game","An","Garden")
	f.play()
	await f.settle(self)
	assert_null(panel.book.story_sheet)
	assert_not_null(await open_book())
	assert_false(f.main.call("_return_to_start_menu"),"Existing journal-open save guard remains")
	f.main.ui_coordinator.close_active()
	assert_true(f.main.call("_return_to_start_menu"))
	await f.settle(self)
	assert_null(panel.book.story_sheet)
	assert_eq(panel.book.paper.get_child_count(),children)
func test_live_locale_reading_is_readonly_and_does_not_mark_pages_read() -> void:
	var before: Dictionary = f.owners()
	var saved: PackedByteArray = FileAccess.get_file_as_bytes("user://saves/slot_1.json")
	var sheet: LifeStoryNotebook = await open_book()
	assert_not_null(sheet)
	for locale: String in ["vi","en","vi"]:
		TranslationServer.set_locale(locale)
		await f.settle(self)
		assert_eq(sheet.header.title.text,tr("STORY_CHAPTER_1"))
		assert_eq(sheet.back_button.text,tr("STORY_BACK"))
		assert_true(sheet.header.progress.text.contains("0/10"))
		for row: LifeStoryMilestoneRow in sheet.milestones.rows: assert_eq(row.status.text,tr("STORY_PLANNED"))
	assert_eq(f.owners(),before)
	assert_eq(FileAccess.get_file_as_bytes("user://saves/slot_1.json"),saved)
