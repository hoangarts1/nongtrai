extends GutTest
const FIXTURE: Script = preload("res://tests/helpers/story_fixture.gd")
var f: RefCounted
var flow: LifeStoryMomentFlow
var journal: NpcPanel
func before_each() -> void:
	f = FIXTURE.new()
	f.setup(self)
	flow = f.main.story_moment_flow
	journal = f.main.npc_system.journal
func after_each() -> void:
	f.cleanup()
	await get_tree().process_frame
func notebook() -> void:
	f.main.npc_system.open_journal()
	await f.settle(self)
	journal.book_controller.story_controller.open()
	await f.settle(self)
func letter() -> void:
	await notebook()
	await f.mouse(self,journal.book.story_sheet.page_links[0].get_global_rect().get_center())
	await f.settle(self)

func test_native_open_tab_escape_cancel_and_confirm_only_read_once() -> void:
	var core: Dictionary = f.core_owners()
	await letter()
	assert_true(flow.panel.visible)
	assert_eq(f.main.ui_coordinator.get_active_panel(),flow.panel)
	assert_true(GameClock.paused)
	assert_false(journal.visible)
	assert_null(journal.book.story_sheet)
	assert_eq(f.main.story_state.serialize().read_pages,[])
	await f.key(self,KEY_TAB)
	assert_true(flow.panel.is_ancestor_of(f.viewport.gui_get_focus_owner()))
	for code: Key in [KEY_Q,KEY_E,KEY_J]:
		await f.key(self,code)
		assert_eq(f.main.ui_coordinator.get_active_panel(),flow.panel)
	await f.key(self,KEY_ESCAPE)
	assert_false(flow.panel.visible)
	assert_true(journal.visible)
	assert_not_null(journal.book.story_sheet)
	assert_eq(f.main.story_state.serialize().read_pages,[])
	assert_true(flow.open(&"intro"))
	await f.settle(self)
	await f.mouse(self,flow.panel.actions.cancel.get_global_rect().get_center())
	assert_eq(f.main.story_state.serialize().read_pages,[])
	assert_true(flow.open(&"intro"))
	await f.settle(self)
	flow.panel.actions.confirm.grab_focus()
	await f.key(self,KEY_ENTER)
	assert_eq(f.main.story_state.serialize().read_pages,["intro"])
	assert_false(flow.panel.visible)
	assert_true(flow.open(&"intro"))
	flow.confirm()
	assert_eq(f.main.story_state.serialize().read_pages,["intro"])
	assert_eq(f.core_owners(),core)
	f.main.ui_coordinator.close_active()
	assert_true(f.main.call("_save_game_to_slot",98))
	assert_true(f.main.call("_load_game_from_slot",98))
	assert_eq(f.main.story_state.serialize().read_pages,["intro"])
	assert_false(flow.panel.visible)
func test_locked_stale_and_reentrant_commands_preserve_guarded_owner() -> void:
	assert_false(flow.open(&"intro"))
	await notebook()
	assert_false(flow.open(&"page_harvest"))
	assert_true(flow.open(&"intro"))
	assert_true(f.main.story_state.observe(PackedStringArray(["first_sowing"])).ok)
	flow.confirm()
	assert_false(flow.result.ok)
	assert_true(flow.panel.error.visible)
	assert_true(flow.panel.actions.confirm.disabled)
	assert_eq(f.main.story_state.serialize().read_pages,[])
	flow.back()
	assert_true(flow.open(&"intro"))
	var attempts: Array[bool] = []
	var callback: Callable = func() -> void:
		attempts.append(f.main.call("_save_game_to_slot",98))
		attempts.append(f.main.call("_load_payload",{}))
		attempts.append(f.main.call("_return_to_start_menu"))
		attempts.append(flow.open(&"intro"))
		flow.confirm()
		flow.back()
		f.main.call("_start_new_game","Wrong","Wrong")
	f.main.story_state.changed.connect(callback)
	flow.confirm()
	f.main.story_state.changed.disconnect(callback)
	assert_eq(attempts,[false,false,false,false])
	assert_eq(f.main.story_state.serialize().read_pages,["intro"])
	assert_eq(f.main.profile.player_name,"Mai")
func test_new_load_title_close_pending_pages_without_acknowledgment_or_replay() -> void:
	await letter()
	assert_true(f.main.call("_load_payload",SaveService.load_game(1)))
	await f.settle(self)
	assert_false(flow.panel.visible)
	assert_eq(f.main.story_state.serialize().read_pages,[])
	await letter()
	f.main.call("_start_new_game","Mai","Garden")
	f.play()
	await f.settle(self)
	assert_false(flow.panel.visible)
	assert_eq(f.main.story_state.serialize(),StorySnapshotCodec.empty())
	await letter()
	assert_true(f.main.call("_return_to_start_menu"))
	await f.settle(self)
	assert_false(flow.panel.visible)
	f.main.call("_continue_game")
	await f.settle(self)
	assert_false(flow.panel.visible)
	assert_eq(f.main.story_state.serialize().read_pages,[])
func test_day_review_preempts_pending_letter_without_ack_or_extra_day() -> void:
	GameClock.set_time(21,0)
	await letter()
	var day: int = GameClock.day_index
	assert_true(f.main.day_end_flow.request())
	assert_false(flow.panel.visible)
	assert_true(f.main.day_end_flow.panel.visible)
	assert_eq(f.main.ui_coordinator.get_active_panel(),f.main.day_end_flow.panel)
	assert_false(flow.open(&"intro"))
	assert_eq(f.main.story_state.serialize().read_pages,[])
	assert_eq(GameClock.day_index,day)
	assert_true(f.main.day_end_flow.cancel())
